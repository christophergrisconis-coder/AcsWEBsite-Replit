{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Design tokens in the W3C Design Tokens (DTCG) format. THIS FILE IS THE SINGLE SOURCE OF TRUTH for the design system. Edit values here only -- do not hand-edit the generated src/index.css or src/generated/tokens.tsx. The dev server regenerates them on every change (scripts/build-tokens.mjs, wired through vite.config.ts). Colors are authored as hex; the generator converts them to `H S% L%` channels for the web theme and keeps hex for mobile (tokens.tsx). Every color role exists in both light and dark.",
  "color": {
    "$type": "color",
    "light": {
      "background": { "$value": "#FAFAFA", "$description": "Near-white page surface." },
      "foreground": { "$value": "#0D0D0D", "$description": "Near-black default text." },
      "border": { "$value": "#D9D9D9" },
      "card": { "$value": "#FFFFFF" },
      "cardForeground": { "$value": "#0D0D0D" },
      "popover": { "$value": "#FFFFFF" },
      "popoverForeground": { "$value": "#0D0D0D" },
      "primary": {
        "$value": "#E5E500",
        "$description": "Electric yellow — the signature brand color. Drives buttons, links, and key emphasis."
      },
      "primaryForeground": { "$value": "#0D0D0D", "$description": "Near-black text on yellow." },
      "secondary": { "$value": "#EBEBEB" },
      "secondaryForeground": { "$value": "#262626" },
      "muted": { "$value": "#E6E6E6" },
      "mutedForeground": { "$value": "#666666" },
      "accent": {
        "$value": "#E5FF00",
        "$description": "Lime-yellow accent, slightly greener than primary for visual pop."
      },
      "accentForeground": { "$value": "#0D0D0D" },
      "destructive": { "$value": "#EF4343" },
      "destructiveForeground": { "$value": "#FFFFFF" },
      "input": { "$value": "#D9D9D9" },
      "ring": { "$value": "#E5E500" },
      "chart1": { "$value": "#E5E500" },
      "chart2": { "$value": "#0099FF" },
      "chart3": { "$value": "#FF4500" },
      "chart4": { "$value": "#9B59B6" },
      "chart5": { "$value": "#00CC88" },
      "sidebar": { "$value": "#FAFAFA" },
      "sidebarForeground": { "$value": "#0D0D0D" },
      "sidebarBorder": { "$value": "#E0E0E0" },
      "sidebarPrimary": { "$value": "#E5E500" },
      "sidebarPrimaryForeground": { "$value": "#0D0D0D" },
      "sidebarAccent": { "$value": "#EBEBEB" },
      "sidebarAccentForeground": { "$value": "#262626" },
      "sidebarRing": { "$value": "#E5E500" }
    },
    "dark": {
      "background": { "$value": "#000000", "$description": "Pure black — maximum contrast dark surface." },
      "foreground": { "$value": "#FFFFFF", "$description": "Pure white text." },
      "border": { "$value": "#333333" },
      "card": { "$value": "#0D0D0D" },
      "cardForeground": { "$value": "#FFFFFF" },
      "popover": { "$value": "#0D0D0D" },
      "popoverForeground": { "$value": "#FFFFFF" },
      "primary": {
        "$value": "#FFFF00",
        "$description": "Pure electric yellow on black — maximum impact."
      },
      "primaryForeground": { "$value": "#000000" },
      "secondary": { "$value": "#1A1A1A" },
      "secondaryForeground": { "$value": "#FFFFFF" },
      "muted": { "$value": "#262626" },
      "mutedForeground": { "$value": "#A6A6A6" },
      "accent": { "$value": "#E5FF00" },
      "accentForeground": { "$value": "#000000" },
      "destructive": { "$value": "#EF4343" },
      "destructiveForeground": { "$value": "#FFFFFF" },
      "input": { "$value": "#333333" },
      "ring": { "$value": "#FFFF00" },
      "chart1": { "$value": "#FFFF00" },
      "chart2": { "$value": "#33AAFF" },
      "chart3": { "$value": "#FF6B35" },
      "chart4": { "$value": "#B97FFF" },
      "chart5": { "$value": "#00FF99" },
      "sidebar": { "$value": "#080808" },
      "sidebarForeground": { "$value": "#FFFFFF" },
      "sidebarBorder": { "$value": "#262626" },
      "sidebarPrimary": { "$value": "#FFFF00" },
      "sidebarPrimaryForeground": { "$value": "#000000" },
      "sidebarAccent": { "$value": "#1A1A1A" },
      "sidebarAccentForeground": { "$value": "#FFFFFF" },
      "sidebarRing": { "$value": "#FFFF00" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["Inter", "system-ui", "sans-serif"],
        "$description": "UI and body text typeface. Clean, neutral, highly legible."
      },
      "serif": {
        "$value": ["Syne", "system-ui", "sans-serif"],
        "$description": "Display and heading typeface. Bold, geometric, wide — used for h1–h6."
      },
      "mono": {
        "$value": ["JetBrains Mono", "Menlo", "monospace"],
        "$description": "Code and technical text."
      }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "0rem",
      "$description": "Zero radius — sharp corners throughout. The design language is angular and precise."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "Base spacing step components multiply."
    }
  }
}
