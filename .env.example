DATABASE_URL=postgresql://ubuntu:YOUR_PASSWORD@localhost:5432/acs_studio
PORT=8080

# Shared admin token for /admin/* pages (sent as x-admin-token)
SESSION_SECRET=change-me-to-a-long-random-string

# Briefing intake notifications
# Required to actually send email. Without SMTP + this address, requests are
# still stored and the notification is logged.
BRIEFING_NOTIFY_EMAIL=partnerships@advancedcreationstudio.com
# BRIEFING_NOTIFY_FROM=noreply@advancedcreationstudio.com

# SMTP (any one of these styles works)
# SMTP_URL=smtps://user:pass@smtp.example.com:465
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
